# The Croupier reads DreamDEX config (NETWORK, VENUE_ID, PRIVATE_KEY, tick/lot,
# AUTO_CLAIM) from the REPO-ROOT .env — same as every ec-* strategy. Copy
# ../../.env.example to ../../.env and fill that in first.
#
# The variables below are the Croupier's own knobs. They can live in the
# repo-root .env too; this file is just the reference.

# Which underlying to make a market on. v1 = BTC only.
EC_UNDERLYING=BTC

# How often to RE-check a market we're already quoting (ms). A fresh window
# still gets its first quote on the next pass; on-chain latency makes a full
# pass ~20-30s anyway, so lower than that just burns gas.
CROUPIER_REFRESH_MS=15000

# Half-spread in probability. 0.02 → quotes 0.48 / 0.52 around a 0.50 fair.
CROUPIER_SPREAD=0.02

# Gas savers — don't touch a resting quote unless it's worth the transactions:
#  - re-post only if the fair (or curve half-spread) moved at least this much
CROUPIER_REQUOTE_FAIR=0.02
#  - ...or the target size changed by at least this fraction
CROUPIER_REQUOTE_SIZE_FRAC=0.25
#  - after N consecutive PostOnlyWouldCross rejections, leave the market alone
CROUPIER_CROSS_BACKOFF_AFTER=3
CROUPIER_CROSS_BACKOFF_MS=120000
#  - only quote rolling windows this short or shorter, in seconds (0 = no limit).
#    Skips the far-out daily/weekly windows whose books barely move.
CROUPIER_MAX_WINDOW_SEC=7200

# Contracts per side per quote, and the net-inventory cap.
CROUPIER_QUOTE_SIZE=25
CROUPIER_MAX_INVENTORY=100

# Fair value: "flat" (anchor 0.50), "drift" (0.50 + k*return), or "curve"
# (@called-it/curve's time-aware model). "drift" and "curve" both need a price feed.
CROUPIER_FAIR=flat
CROUPIER_DRIFT_SENSITIVITY=8
CROUPIER_ANCHOR_LO=0.40
CROUPIER_ANCHOR_HI=0.60

# "curve" mode's own knobs — see packages/curve/src/index.ts for what each does.
CURVE_VOL_ANNUAL=0.6
CURVE_SIZE_DECAY_POW=1.5
CURVE_WIDEN_GAIN=3
CURVE_MIN_QUOTE_SEC=45

# Kill switch: pause + flatten if realized USDso falls this far below the day baseline.
CROUPIER_MAX_DAY_LOSS=50

# Optional alert webhook (Slack / Discord / Telegram incoming-webhook URL).
# CROUPIER_ALERT_WEBHOOK=

# Phase 1.4: address of the deployed CalledItFloat vault. Empty = trade from PRIVATE_KEY.
# CROUPIER_FLOAT=0x...
# Extra ceiling on a single borrow (tUSDC, plain units). 0 = just the vault's own caps.
CROUPIER_FLOAT_TARGET=0
# How often the bot settles + re-borrows while running (ms), so the vault's
# share price moves live instead of only at shutdown. 0 = borrow once, settle at stop.
CROUPIER_FLOAT_CYCLE_MS=300000
