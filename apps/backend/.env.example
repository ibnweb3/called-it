# Called It backend

PORT=8787
# testnet (chain 50312) or mainnet (chain 5031). Phase 5 flips this.
NETWORK=testnet
# Optional — overrides the bundled venue id. Read it off a live market row if the
# indexer reports "no rounds" (these move). See CALLED-IT.md Phase 0.
# VENUE_ID=0x...

# SQLite cache file. The chain is the source of truth; this rebuilds from it on a
# cold start, so it's safe to lose. On Railway, point it at a mounted volume.
DATABASE_PATH=./called-it.db

# How often the indexer polls the venue for round + settlement changes.
INDEXER_POLL_MS=5000

# Secret for the session JWTs handed to burner wallets. Any long random string.
JWT_SECRET=change-me-to-something-long-and-random

# Comma-separated allowed origins for the web app. * in dev.
CORS_ORIGIN=*

# Social-only: serve auth + squads + leaderboard for the demo-mode web app and
# skip everything that needs a live chain (indexer, round/price/live routes).
# This is how the hosted backend backs cross-device squads. Adds POST
# /v1/calls/demo (play-money call records, no on-chain position check).
# In SOCIAL_ONLY mode the SQLite file is the ONLY copy of squad state — put
# DATABASE_PATH on a persistent volume. See deploy/backend.md.
# SOCIAL_ONLY=1

# Optional: mainnet underlying price feed (testnet is bundled by the SDK).
# PRICE_FEED_URL=

# ── Telegram (optional in Phase 2 — the notifier half only) ──────────────────
# Set to turn on result / round-closing DMs. Full command handling is Phase 4.
# TELEGRAM_BOT_TOKEN=
# Public base URL the bot's deep links point back to (the web app).
# WEB_APP_URL=https://calledit.example
