# The Called It backend (apps/backend). Vite reads both VITE_* and NEXT_PUBLIC_*.
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_FAUCET_URL=https://testnet.somnia.network/

# demo | live
#   demo — no backend, no chain: a local round engine deals rounds and settles
#          them. Everything is play money. This is the default so the app runs
#          on its own. Connecting a wallet is optional (identity only).
#   live — talk to NEXT_PUBLIC_API_URL and place real calls signed in the
#          player's connected wallet (injected EIP-1193, e.g. MetaMask) on Somnia.
NEXT_PUBLIC_MODE=demo
